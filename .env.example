# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
DATABASE_URL=postgres://gtd:gtd@localhost:5432/gtd

# Google Calendar (Step 8 — not needed until then)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8000/google/callback
FERNET_KEY=

# ntfy (Step 10 — not needed until then)
NTFY_TOPIC=

# Backups (Step 12 — prod only; unset BACKUP_S3_BUCKET makes backup_database a no-op).
# AWS credentials themselves come from the normal boto3 chain (IAM role on EC2
# ideally, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) - not set here.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=gtd-backups/

# Logging (Step 12 — prod only; ignored when DEBUG=True, console-only then)
DJANGO_LOG_DIR=/var/log/gtd
